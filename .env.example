# Copy this file to .env. Never commit .env or share your Groq key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Real lab mode uses BOTH restricted roles created by vm/01_create_lab.sql.
# Use the exact same private host-only IPv4 address in both DSNs and PEGASUS_LAB_HOST.
POSTGRES_DSN=postgresql://pegasus_app:PegasusApp_Change123!@192.168.56.11:5432/pegasus_lab
POSTGRES_TEST_DSN=postgresql://pegasus_test:PegasusTest_Change123!@192.168.56.10:5432/pegasus_lab
PEGASUS_LAB_HOST=192.168.56.101

# Leave false until VirtualBox is on Host-only networking and both DSNs are verified.
PEGASUS_ENABLE_LAB_TESTS=true
PEGASUS_MODE=simulation
ROUND_INTERVAL_SECONDS=3
MAX_ROUNDS=10
